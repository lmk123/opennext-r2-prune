{
  "name": "opennext-r2-prune",
  "version": "0.1.0",
  "description": "Prune stale build caches of @opennextjs/cloudflare (OpenNext for Next.js on Cloudflare Workers) from your R2 incremental cache bucket, using R2 lifecycle rules instead of listing and deleting objects. CLI and library.",
  "keywords": [
    "opennext",
    "opennextjs",
    "opennextjs-cloudflare",
    "@opennextjs/cloudflare",
    "nextjs",
    "next.js",
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-r2",
    "r2",
    "r2-lifecycle",
    "lifecycle",
    "incremental-cache",
    "isr",
    "cache",
    "build-id",
    "cleanup",
    "prune",
    "garbage-collection",
    "cli",
    "cron"
  ],
  "license": "MIT",
  "author": "lmk123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmk123/opennext-r2-prune.git"
  },
  "homepage": "https://github.com/lmk123/opennext-r2-prune#readme",
  "bugs": {
    "url": "https://github.com/lmk123/opennext-r2-prune/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "opennext-r2-prune": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.chmodSync('dist/cli.js',0o755);fs.rmSync('dist/cli.d.ts')\"",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
