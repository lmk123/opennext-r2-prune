{
  "name": "opennext-r2-prune",
  "version": "0.0.0",
  "description": "Delete stale build caches from your Cloudflare R2 bucket for @opennextjs/cloudflare (OpenNext) Next.js deployments",
  "keywords": [
    "opennextjs-cloudflare",
    "opennext",
    "cloudflare",
    "r2",
    "nextjs",
    "isr",
    "cache",
    "build-id",
    "cleanup",
    "prune"
  ],
  "license": "MIT",
  "author": "lmk123",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "opennext-r2-prune": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  }
}
